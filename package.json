{
  "name": "goalfuel-nutrition",
  "version": "1.0.0",
  "description": "E-commerce nutrition bowl store with TypeScript, SCSS, and Nginx",
  "private": true,
  "scripts": {
    "build:sass": "sass frontend/src/scss:frontend/public/css --no-source-map --style=compressed",
    "build:ts": "tsc",
    "build": "npm run build:sass && npm run build:ts",
    "watch:sass": "sass --watch frontend/src/scss:frontend/public/css",
    "watch:ts": "tsc --watch",
    "api": "json-server --watch db.json --port 3000",
    "docker": "docker compose up",
    "dev": "concurrently \"npm:watch:sass\" \"npm:watch:ts\" \"npm:api\" \"npm:docker\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "json-server": "^0.17.4",
    "sass": "^1.77.0",
    "typescript": "^5.4.0"
  }
}
